public node transmission_channel => __engine_sim__transmission_channel { /* void */ }
public node throttle_channel => __engine_sim__throttle_channel { /* void */ }
public node compressor_stage_channel => __engine_sim__compressor_stage_channel { /* void */ }
public node forced_induction_channel => __engine_sim__forced_induction_channel { /* void */ }

private node turbulence_to_flame_speed_ratio_default {
    alias output __out:
        function(5.0)
            .add_sample(0.0, 3.0)
            .add_sample(5.0, 1.5 * 5.0)
            .add_sample(10.0, 1.5 * 10.0)
            .add_sample(15.0, 1.5 * 15.0)
            .add_sample(20.0, 1.5 * 20.0)
            .add_sample(25.0, 1.5 * 25.0)
            .add_sample(30.0, 1.5 * 30.0)
            .add_sample(35.0, 1.5 * 35.0)
            .add_sample(40.0, 1.5 * 40.0)
            .add_sample(45.0, 1.5 * 45.0);
}

public node fuel => __engine_sim__fuel {
    input name [string]: "Gasoline [Default]";
    input molecular_mass [float]: 100 * units.g;
    input energy_density [float]: 48.1 * units.kJ / units.g;
    input density [float]: 0.755 * units.kg / units.L;
    input molecular_afr [float]: 25 / 2.0;
    input turbulence_to_flame_speed_ratio [function]:
        turbulence_to_flame_speed_ratio_default();
    input max_burning_efficiency [float]: 0.8;
    input burning_efficiency_randomness [float]: 0.5;
    input low_efficiency_attenuation [float]: 0.6;
    input max_turbulence_effect [float]: 2.0;
    input max_dilution_effect [float]: 10.0;
    // How much leftover exhaust in the charge slows the flame (0: not at all, 1: the full
    // laminar-flame correlation). Charges too diluted to burn misfire: the lope of big-overlap
    // engines at idle.
    input dilution_sensitivity [float]: 0.0;
    // Firing-to-firing spread of the flame speed, growing with leftover exhaust in the charge
    // (0: none). With dilution_sensitivity, this makes a diluted idle irregular.
    input cyclic_variation [float]: 0.0;
    alias output __out [fuel_channel];
}

// Engine
public node engine_parameters {
    input name: "";
    input redline: 6000 * units.rpm;
    input starter_speed: 200 * units.rpm;
    input starter_torque: 200 * units.lb_ft;
    input fuel: fuel();
}

private node _engine => __engine_sim__engine {
    input name [string];
    
    input redline [float];
    input starter_speed [float];
    input starter_torque [float];
    input dyno_min_speed [float];
    input dyno_max_speed [float];
    input dyno_hold_step [float];

    input fuel [fuel];
    input throttle [throttle_channel];

    input simulation_frequency [float];
    input hf_gain [float];
    input jitter [float];
    input noise [float];
    input convolution [float];
    input cycle_angle [float];
    input idle_rpm [float];
    input idle_free_running [float];

    input fluid_simulation_steps [float];
    input max_sle_solver_steps [float];
    input heat_transfer_coefficient [float];
    input block_temperature [float];
    input heat_transfer_reference_speed [float];
    input pipe_resolution [float];
    input real_gas [float];

    alias output __out [engine_channel];
}

public node engine {
    input params: engine_parameters();
    input name: params.name;

    input redline: params.redline;
    input starter_speed: params.starter_speed;
    input starter_torque: params.starter_torque;
    input dyno_min_speed: 1000 * units.rpm;
    input dyno_max_speed: redline;
    input dyno_hold_step: 100 * units.rpm;

    input fuel: params.fuel;
    input throttle_gamma: 1.0;
    input idle_speed: 0.0;                  // Idle air control target (0: none)
    input idle_proportional: 0.6;           // How hard it reacts to the speed dropping
    input idle_integral: 0.5;               // How fast it builds up to hold the speed
    input idle_max_opening: 0.3;            // The most it opens the throttle (as a pedal position)
    input idle_fuel_cut: 1.5;               // Overrun fuel cut above this many times idle_speed (0: none)
    input throttle:
        direct_throttle_linkage(
            gamma: throttle_gamma,
            idle_speed: idle_speed,
            idle_proportional: idle_proportional,
            idle_integral: idle_integral,
            idle_max_opening: idle_max_opening,
            idle_fuel_cut: idle_fuel_cut);

    input simulation_frequency: 10000;
    input hf_gain: 0.01;
    input jitter: 0.5;
    input noise: 1.0;
    input convolution: 1.0;

    // One engine cycle: 720 deg for four-strokes, 360 deg for two-strokes. Camshafts turn
    // once per cycle, and ignition angles are within it.
    input cycle_angle: 720 * units.deg;

    // Where this engine is meant to idle (0: work it out). BeamNG cars tuned to this engine
    // idle here; set it when the engine's closed-throttle idle is lumpy or fussy.
    input idle_rpm: 0.0;
    // In BeamNG, idle freely (own idle control and fuel cut) instead of following the game's
    // idle speed: for lumpy big-overlap idles (1: yes)
    input idle_free_running: 0;

    // Performance: fewer fluid steps / solver steps run faster but less stably
    input fluid_simulation_steps: 8;
    input max_sle_solver_steps: 128;

    // Charge heating: gas-to-wall heat transfer (W/m^2/K) and wall temperature
    input heat_transfer_coefficient: 100.0;
    input block_temperature: 90.0 * units.C + units.K0;
    // When set, heat_transfer_coefficient holds at this mean piston speed and scales with
    // speed^0.8, as real heat loss does (0: constant, upstream)
    input heat_transfer_reference_speed: 0.0;

    // Intake runners and exhaust primaries as 1-D pipes with this many cells per metre, so
    // pressure waves travel in them: ram tuning, scavenging and reversion by the physics.
    // 0 keeps upstream's lumped volumes. 30-60 is plenty.
    input pipe_resolution: 0.0;

    // Real gas heat capacities: hot and burned gas take more heat per degree than cold air,
    // so combustion peaks lower and the engine is as efficient as a real one rather than an
    // ideal air cycle (1: yes). Needs about 25% more max_burning_efficiency than upstream's
    // gas for the same power (0: upstream's gas, gamma 1.4 throughout).
    input real_gas: 0;

    alias output __out [_engine]:
        _engine(
            name: name,

            redline: redline,
            starter_speed: starter_speed,
            starter_torque: starter_torque,
            dyno_min_speed: dyno_min_speed,
            dyno_max_speed: dyno_max_speed,
            dyno_hold_step: dyno_hold_step,

            fuel: fuel,
            throttle: throttle,

            simulation_frequency: simulation_frequency,
            hf_gain: hf_gain,
            jitter: jitter,
            noise: noise,
            convolution: convolution,
            cycle_angle: cycle_angle,
            idle_rpm: idle_rpm,
            idle_free_running: idle_free_running,

            fluid_simulation_steps: fluid_simulation_steps,
            max_sle_solver_steps: max_sle_solver_steps,
            heat_transfer_coefficient: heat_transfer_coefficient,
            block_temperature: block_temperature,
            heat_transfer_reference_speed: heat_transfer_reference_speed,
            pipe_resolution: pipe_resolution,
            real_gas: real_gas
        );
}

// The pedal works the throttle directly. With idle_speed set, an idle air controller holds that
// speed when the pedal is up (opening the throttle up to idle_max_opening, as a pedal position).
public node direct_throttle_linkage => __engine_sim__direct_throttle_linkage {
    input gamma [float]: 1.0;
    input idle_speed [float]: 0.0;
    input idle_max_opening [float]: 0.3;
    input idle_proportional [float]: 0.6;
    input idle_integral [float]: 0.5;
    input idle_fuel_cut [float]: 1.5;
    alias output __out [throttle_channel];
}

public node governor => __engine_sim__governor {
    input min_speed [float]: 1.0;
    input max_speed [float]: 1.0;
    input min_v [float]: -2.0;
    input max_v [float]: 2.0;
    input k_s [float]: 1.0;
    input k_d [float]: 300.0;
    input gamma [float]: 0.1;
    alias output __out [throttle_channel];
}

// Crankshaft
public node crankshaft_parameter_defaults {
    input throw: 0.0;
    input flywheel_mass: 0.0;
    input mass: 0.0;
    input friction_torque: 0.0;
    input moment_of_inertia: 0.0;
    input position_x: 0.0;
    input position_y: 0.0;
    input tdc: 0.0;
}

private node _crankshaft => __engine_sim__crankshaft {
    input throw [float]: 0.0;
    input flywheel_mass [float]: 0.0;
    input mass [float]: 0.0;
    input friction_torque [float]: 0.0;
    input moment_of_inertia [float]: 0.0;
    input position_x [float]: 0.0;
    input position_y [float]: 0.0;
    input tdc [float]: 0.0;
    alias output __out [crankshaft_channel];
}

public node crankshaft {
    input params: crankshaft_parameter_defaults();
    input throw: params.throw;
    input flywheel_mass: params.flywheel_mass;
    input mass: params.mass;
    input friction_torque: params.friction_torque;
    input moment_of_inertia: params.moment_of_inertia;
    input position_x: params.position_x;
    input position_y: params.position_y;
    input tdc: params.tdc;
    alias output __out [_crankshaft]:
        _crankshaft(
            throw: throw,
            flywheel_mass: flywheel_mass,
            mass: mass,
            friction_torque: friction_torque,
            moment_of_inertia: moment_of_inertia,
            position_x: position_x,
            position_y: position_y,
            tdc: tdc
        );
}

