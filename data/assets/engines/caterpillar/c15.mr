// Caterpillar C15 ACERT [I6 twin-turbo diesel], 15.2 L (928 cu in): 137 x 171.5 mm, 18:1, MEUI
// injectors, series turbos (a big low-pressure turbo feeding a small wastegated high-pressure one)
// through an air-to-air aftercooler. 625 hp and 2050 lb-ft at 1200, governed at 2100, idling at
// 600. With its Jake brake.
// Built from this project's Series 60 script.

import "engine_sim.mr"

units units()
constants constants()
impulse_response_library ir_lib()

private node wires {
    output wire1: ignition_wire();
    output wire2: ignition_wire();
    output wire3: ignition_wire();
    output wire4: ignition_wire();
    output wire5: ignition_wire();
    output wire6: ignition_wire();
}

label cycle(2 * 360 * units.deg)
public node wb_ignition {
    input wires;
    input timing_curve;
    input rev_limit: 7500 * units.rpm;
    alias output __out:
        ignition_module(
            timing_curve: timing_curve,
            rev_limit: rev_limit,
            limiter_duration: 0.1
        )
            .connect_wire(wires.wire1, (0.0 / 6.0) * cycle)
            .connect_wire(wires.wire5, (1.0 / 6.0) * cycle)
            .connect_wire(wires.wire3, (2.0 / 6.0) * cycle)
            .connect_wire(wires.wire6, (3.0 / 6.0) * cycle)
            .connect_wire(wires.wire2, (4.0 / 6.0) * cycle)
            .connect_wire(wires.wire4, (5.0 / 6.0) * cycle);
}

public node c15_camshaft_builder {
    input lobe_profile: comp_cams_magnum_11_450_8_lobe_profile();
    input intake_lobe_profile: lobe_profile;
    input exhaust_lobe_profile: lobe_profile;
    input lobe_separation: 110.0 * units.deg;
    input intake_lobe_center: lobe_separation;
    input exhaust_lobe_center: lobe_separation;
    input advance: 0.0 * units.deg;
    input base_radius: 0.75 * units.inch;

    output intake_cam: _intake_cam;
    output exhaust_cam: _exhaust_cam;

    camshaft_parameters params(
        advance: advance,
        base_radius: base_radius
    )

    camshaft _intake_cam(params, lobe_profile: intake_lobe_profile)
    camshaft _exhaust_cam(params, lobe_profile: exhaust_lobe_profile)

    label rot(2 * (360 / 6.0) * units.deg)
    label rot360(360 * units.deg)

    // 1 5 3 6 2 4
    _exhaust_cam
        .add_lobe((rot360 - exhaust_lobe_center) + 0 * rot)
        .add_lobe((rot360 - exhaust_lobe_center) + 4 * rot)
        .add_lobe((rot360 - exhaust_lobe_center) + 2 * rot)
        .add_lobe((rot360 - exhaust_lobe_center) + 5 * rot)
        .add_lobe((rot360 - exhaust_lobe_center) + 1 * rot)
        .add_lobe((rot360 - exhaust_lobe_center) + 3 * rot)

    _intake_cam
        .add_lobe(rot360 + intake_lobe_center + 0 * rot)
        .add_lobe(rot360 + intake_lobe_center + 4 * rot)
        .add_lobe(rot360 + intake_lobe_center + 2 * rot)
        .add_lobe(rot360 + intake_lobe_center + 5 * rot)
        .add_lobe(rot360 + intake_lobe_center + 1 * rot)
        .add_lobe(rot360 + intake_lobe_center + 3 * rot)
}

private node c15_head {
    input intake_camshaft;
    input exhaust_camshaft;
    input chamber_volume: 50 * units.cc;
    input intake_runner_volume: 149.6 * units.cc;
    input intake_runner_cross_section_area: 2.6 * units.inch * 2.6 * units.inch;
    input exhaust_runner_volume: 50.0 * units.cc;
    input exhaust_runner_cross_section_area: 2.0 * units.inch * 2.0 * units.inch;

    input flow_attenuation: 1.0;
    input lift_scale: 1.0;
    input flip_display: false;
    alias output __out: head;

    function intake_flow(50 * units.thou)
    intake_flow
        .add_flow_sample(0 * lift_scale, 0 * flow_attenuation)
        .add_flow_sample(50 * lift_scale, 58 * flow_attenuation)
        .add_flow_sample(100 * lift_scale, 103 * flow_attenuation)
        .add_flow_sample(150 * lift_scale, 156 * flow_attenuation)
        .add_flow_sample(200 * lift_scale, 214 * flow_attenuation)
        .add_flow_sample(250 * lift_scale, 249 * flow_attenuation)
        .add_flow_sample(300 * lift_scale, 268 * flow_attenuation)
        .add_flow_sample(350 * lift_scale, 280 * flow_attenuation)
        .add_flow_sample(400 * lift_scale, 280 * flow_attenuation)
        .add_flow_sample(450 * lift_scale, 281 * flow_attenuation)

    function exhaust_flow(50 * units.thou)
    exhaust_flow
        .add_flow_sample(0 * lift_scale, 0 * flow_attenuation)
        .add_flow_sample(50 * lift_scale, 37 * flow_attenuation)
        .add_flow_sample(100 * lift_scale, 72 * flow_attenuation)
        .add_flow_sample(150 * lift_scale, 113 * flow_attenuation)
        .add_flow_sample(200 * lift_scale, 160 * flow_attenuation)
        .add_flow_sample(250 * lift_scale, 196 * flow_attenuation)
        .add_flow_sample(300 * lift_scale, 222 * flow_attenuation)
        .add_flow_sample(350 * lift_scale, 235 * flow_attenuation)
        .add_flow_sample(400 * lift_scale, 245 * flow_attenuation)
        .add_flow_sample(450 * lift_scale, 246 * flow_attenuation)

    generic_cylinder_head head(
        chamber_volume: chamber_volume,
        intake_runner_volume: intake_runner_volume,
        intake_runner_cross_section_area: intake_runner_cross_section_area,
        exhaust_runner_volume: exhaust_runner_volume,
        exhaust_runner_cross_section_area: exhaust_runner_cross_section_area,

        intake_port_flow: intake_flow,
        exhaust_port_flow: exhaust_flow,
        valvetrain: standard_valvetrain(
            intake_camshaft: intake_camshaft,
            exhaust_camshaft: exhaust_camshaft
        ),
        flip_display: flip_display
    )
}

public node caterpillar_c15 {
    alias output __out: engine;

    wires wires()

    engine engine(
        name: "Caterpillar C15 ACERT [I6 twin-turbo diesel]",
        starter_torque: 900 * units.lb_ft,
        starter_speed: 150 * units.rpm,
        redline: 2300 * units.rpm,
        real_gas: 1,                        // Real gas heat capacities
        pipe_resolution: 12,                // Waves in the exhaust pipes: the bark and rasp
        friction_model: 1,                  // Friction as a mean effective pressure
        fmep_constant: 55 * units.kPa,      // Big bearings, gear train, cam-driven unit injectors
        idle_rpm: 600 * units.rpm,
        // The governor: 600 rpm idle, fuel falling away above 2100
        diesel_idle_speed: 600 * units.rpm,
        diesel_rated_speed: 2100 * units.rpm,
        diesel_fuel_per_injection: 0.3 * units.g,  // 300 mg
        diesel_peak_torque_speed: 1200 * units.rpm,
        diesel_rated_fuel: 0.84,                     // The fuel map's droop to rated power
        diesel_max_fuel: 0.7,               // Smoke limit
        jake_brake_flow: k_carb(60),         // Cracked open, not flung: a slower release
        combustion_noise: 0.0,
        fuel: diesel_fuel(
            max_burning_efficiency: 0.95,
            injector_spread: 0.015,
            idle_shot_variation: 0.15       // Small idle deliveries scatter: a ragged idle
        ),
        // Less of the pressure's derivative than upstream's 0.01 (which makes every engine
        // bright) and some of the plain pressure: the low-end weight
        hf_gain: 0.002,
        noise: 0.3,
        jitter: 0.23,
        simulation_frequency: 10000
    )

    label stroke(171.5 * units.mm)
    label bore(137.2 * units.mm)
    label rod_length(285 * units.mm)
    label rod_mass(4500 * units.g)
    label compression_height(80 * units.mm)
    label crank_mass(155 * units.kg)
    label flywheel_mass(70 * units.kg)
    label flywheel_radius(9 * units.inch)

    label crank_moment(
        disk_moment_of_inertia(mass: crank_mass, radius: stroke / 2)
    )
    label flywheel_moment(
        disk_moment_of_inertia(mass: flywheel_mass, radius: flywheel_radius)
    )
    label other_moment( // Moment from cams, pulleys, etc [estimated]
        disk_moment_of_inertia(mass: 20 * units.kg, radius: 8.0 * units.cm)
    )

    crankshaft c0(
        throw: stroke / 2,
        flywheel_mass: flywheel_mass,
        mass: crank_mass,
        friction_torque: 10.0 * units.lb_ft,
        moment_of_inertia:
            crank_moment + flywheel_moment + other_moment,
        position_x: 0.0,
        position_y: 0.0,
        tdc: constants.pi / 2
    )

    // 1 5 3 6 2 4
    rod_journal rj0(angle: 0 * units.deg)
	rod_journal rj1(angle: 480 * units.deg)
	rod_journal rj2(angle: 240 * units.deg)
	rod_journal rj3(angle: 600 * units.deg)
    rod_journal rj4(angle: 120 * units.deg)
    rod_journal rj5(angle: 360 * units.deg)

    c0
        .add_rod_journal(rj0)
        .add_rod_journal(rj1)
        .add_rod_journal(rj2)
        .add_rod_journal(rj3)
        .add_rod_journal(rj4)
        .add_rod_journal(rj5)

    piston_parameters piston_params(
        mass: (4500) * units.g,
        blowby: 0,
        compression_height: compression_height,
        wrist_pin_position: 0 * units.mm,
        displacement: 0.0
    )

    connecting_rod_parameters cr_params(
        mass: rod_mass,
        moment_of_inertia: rod_moment_of_inertia(
            mass: rod_mass,
            length: rod_length
        ),
        center_of_mass: 0.0,
        length: rod_length
    )

    cylinder_bank_parameters bank_params(
        bore: bore,
        deck_height: stroke / 2 + rod_length + compression_height
    )

    // No throttle plate: the intake is open, the fuel sets the power
    intake intake(
        plenum_volume: 10.0 * units.L,
        plenum_cross_section_area: 100.0 * units.cm2,
        intake_flow_rate: k_carb(3000.0),
        runner_flow_rate: k_carb(500.0),
        runner_length: 16.0 * units.inch,
        idle_flow_rate: k_carb(0.0),
        idle_throttle_plate_position: 0.0
    )

    exhaust_system_parameters es_params(
        outlet_flow_rate: k_carb(2500.0),
        primary_tube_length: 12.0 * units.inch,
        primary_flow_rate: k_carb(800.0),
        velocity_decay: 1.0
    )
    
    exhaust_system exhaust0(
        es_params,
        length: 100.0 * units.inch,
        audio_volume: 0.2,
        impulse_response: ir_lib.straight_stack_0)

    // Series turbos: the big low-pressure turbo feeds the small high-pressure one, which is
    // wastegated; then an air-to-air aftercooler. No throttle, so no blow-off valve.
    forced_induction turbo(
        intake: intake,
        exhaust_system: exhaust0,
        charge_volume: 25.0 * units.L,
        interstage_volume: 4.0 * units.L,
        intercooler: 0.75,
        boost: 260 * units.kPa,
        wastegate_flow: k_carb(700),
        whine_volume: 1.0,
        whine_floor: 0.3,
        hiss_volume: 0.3
    )
    turbo.add_stage(
        turbocharger(
            compressor_radius: 50 * units.mm,
            compressor_flow: 1.4 * units.kg / units.sec,
            turbine_radius: 50 * units.mm,
            turbine_flow: k_carb(130),
            inertia: 0.0009,
            max_speed: 80000 * units.rpm,
            duct_area: 70 * units.cm2,
            whine_order: 13.0,
            feeds_blower: 1.0                   // The low-pressure turbo: into the high-pressure one
        )
    )
    turbo.add_stage(
        turbocharger(
            compressor_radius: 36 * units.mm,
            compressor_flow: 0.8 * units.kg / units.sec,
            turbine_radius: 36 * units.mm,
            turbine_flow: k_carb(90),
            inertia: 0.0003,
            max_speed: 115000 * units.rpm,
            duct_area: 40 * units.cm2,
            whine_order: 17.0
        )
    )

    label spacing(1.0 * units.inch)   // A divided manifold: front three and rear three into the turbos

    cylinder_bank b0(bank_params, angle: 0)
    b0
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.1)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj0,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire1,
            primary_length: spacing * 3 + 4 * units.inch,
            sound_attenuation: 1.0
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.05)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj1,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire2,
            primary_length: spacing * 2 + 4 * units.inch,
            sound_attenuation: 1.0
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.1)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj2,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire3,
            primary_length: spacing * 1 + 4 * units.inch,
            sound_attenuation: 1.0
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.05)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj3,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire4,
            primary_length: spacing * 1 + 4 * units.inch,
            sound_attenuation: 1.0
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.1)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj4,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire5,
            primary_length: spacing * 2 + 4 * units.inch,
            sound_attenuation: 1.0
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.05)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj5,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire6,
            primary_length: spacing * 3 + 4 * units.inch,
            sound_attenuation: 1.0
        )

    engine
        .add_cylinder_bank(b0)

    engine.add_crankshaft(c0)

    harmonic_cam_lobe intake_lobe(
        duration_at_50_thou: 220 * units.deg,
        gamma: 1.1,
        lift: 14 * units.mm,
        steps: 100
    )

    harmonic_cam_lobe exhaust_lobe(
        duration_at_50_thou: 220 * units.deg,
        gamma: 1.1,
        lift: 14 * units.mm,
        steps: 100
    )

    c15_camshaft_builder camshaft(
        lobe_profile: "N/A",

        intake_lobe_profile: intake_lobe,
        exhaust_lobe_profile: exhaust_lobe,
        intake_lobe_center: 116 * units.deg,
        exhaust_lobe_center: 116 * units.deg,
        base_radius: (34.0 / 2) * units.mm
    )

    b0.set_cylinder_head (
        c15_head(
            chamber_volume: 149 * units.cc,  // 18:1
            intake_camshaft: camshaft.intake_cam,
            exhaust_camshaft: camshaft.exhaust_cam,
            flow_attenuation: 1.9          // Four big valves per cylinder
        )
    )

    // Start of injection, degrees before TDC (MEUI injectors)
    function timing_curve(1000 * units.rpm)
    timing_curve
        .add_sample(0000 * units.rpm, 6 * units.deg)
        .add_sample(1000 * units.rpm, 8 * units.deg)
        .add_sample(2000 * units.rpm, 11 * units.deg)
        .add_sample(3000 * units.rpm, 13 * units.deg)
        .add_sample(4000 * units.rpm, 13 * units.deg)

    engine.add_ignition_module(
        wb_ignition(
            wires: wires,
            timing_curve: timing_curve,
            rev_limit: 2500 * units.rpm
        )
    )
}

// Flame speed against turbulence: upstream's default (1.5x) scaled by gain
public node fast_flame {
    input gain: 1.5;
    alias output __out:
        function(5.0)
            .add_sample(0.0, 3.0)
            .add_sample(5.0, gain * 5.0)
            .add_sample(10.0, gain * 10.0)
            .add_sample(15.0, gain * 15.0)
            .add_sample(20.0, gain * 20.0)
            .add_sample(25.0, gain * 25.0)
            .add_sample(30.0, gain * 30.0)
            .add_sample(35.0, gain * 35.0)
            .add_sample(40.0, gain * 40.0)
            .add_sample(45.0, gain * 45.0);
}



// A loaded tractor-trailer and a ten-speed
private node truck {
    alias output __out:
        vehicle(
            mass: 30000 * units.lb,
            drag_coefficient: 0.7,
            cross_sectional_area: (100 * units.inch) * (140 * units.inch),
            diff_ratio: 3.70,
            tire_radius: 20 * units.inch,
            rolling_resistance: 1500 * units.N
        );
}

private node truck_transmission {
    alias output __out:
        transmission(max_clutch_torque: 3000 * units.lb_ft)
        .add_gear(12.94)
        .add_gear(9.29)
        .add_gear(6.75)
        .add_gear(4.90)
        .add_gear(3.62)
        .add_gear(2.64)
        .add_gear(1.90)
        .add_gear(1.38)
        .add_gear(1.00)
        .add_gear(0.74);
}

public node main {
    set_engine(caterpillar_c15())
    set_vehicle(truck())
    set_transmission(truck_transmission())
}
