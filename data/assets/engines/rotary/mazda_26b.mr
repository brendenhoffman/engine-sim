// Mazda 26B [4-rotor], the 787B Le Mans engine (peripheral intake ports)
// Built from the shared Mazda rotor in mazda_rotary.mr (see there for how rotaries are described).
// Peripheral intake ports open 80 deg before overlap TDC and shut 80 deg after BDC, with a race
// exhaust port: about 150 deg of overlap, so it barely idles and screams up top. Short open exhaust.

import "engine_sim.mr"
import "themes/default.mr"
import "mazda_rotary.mr"

units units()
constants constants()
impulse_response_library ir_lib()

public node mazda_26b {
    alias output __out: engine;

    engine engine(
        name: "Mazda 26B [4-rotor]",
        starter_torque: 200 * units.lb_ft,
        starter_speed: 800 * units.rpm,   // Spun fast: below this its ports just pump the same gas back and forth
        redline: 9000 * units.rpm,
        real_gas: 1,                       // Real gas heat capacities (hot gas takes more heat per degree)
        cycle_angle: rotary_cycle(),
        idle_free_running: 1,              // In BeamNG it idles freely, lumpy as on its own
        // Runners and primaries as pipes: waves, ram and reversion from the physics
        pipe_resolution: 25,
        // Big port overlap makes the idle fragile: a slow, gentle idle air controller catches
        // it before it stalls. A quick one chases every lurch and turns the lope into a surge.
        idle_speed: 1800 * units.rpm,
        idle_proportional: 0.3,
        idle_integral: 0.1,
        idle_max_opening: 0.2,
        idle_fuel_cut: 1.3,             // Fuel cut on overruns above 1.3x idle (standalone only)
        // Rotor chambers lose a lot of heat through their long, thin walls; less at idle
        heat_transfer_coefficient: 800,
        heat_transfer_reference_speed: 20,
        idle_rpm: 2000 * units.rpm,             // Where a BeamNG car tuned to it idles
        throttle_gamma: 2.0,
        fuel: fuel(
            max_burning_efficiency: 0.93,             // Calibrated to the real engine's torque
            dilution_sensitivity: 1.0,          // Leftover exhaust slows the flame...
            cyclic_variation: 4.0,              // ...and makes it vary firing to firing: the idle lope
            turbulence_to_flame_speed_ratio: rotary_flame_speed()
        ),
        hf_gain: 0.01,
        noise: 1.0,
        jitter: 0.3,
        simulation_frequency: 16000,
        fluid_simulation_steps: 4
    )

    rotary_wires wires()
    rotary_shaft c0(rotors: 4, flywheel_mass: 5 * units.kg)

    intake intake(
        plenum_volume: 5.00 * units.L,
        plenum_cross_section_area: 60 * units.cm2,
        intake_flow_rate: k_carb(3000),
        runner_flow_rate: k_carb(600.0),
        runner_length: 14.0 * units.inch,
        idle_flow_rate: k_carb(0.0),
        idle_throttle_plate_position: 0.99,  // Idle air: 1% (its idle control adds a little when it sags)
        velocity_decay: 0.5
    )

    exhaust_system_parameters es_params(
        outlet_flow_rate: k_carb(3500),
        primary_tube_length: 8.0 * units.inch,
        primary_flow_rate: k_carb(900.0),
        velocity_decay: 1.0
    )

    exhaust_system exhaust0(
        es_params,
        audio_volume: 3.0,
        length: 40 * units.inch,
        impulse_response: ir_lib.minimal_muffling_01
    )

    mazda_rotor r1(
        phase: 0 * units.deg, intake: intake, exhaust_system: exhaust0,
        wire0: wires.w0, wire1: wires.w1, wire2: wires.w2,
        primary_length: 6 * units.inch,
        ports: mazda_rotor_ports(phase: 0 * units.deg,
            intake_opens: 540 * units.deg - 80 * units.deg, intake_closes: 810 * units.deg + 80 * units.deg, intake_flow: 480.0,
            exhaust_opens: 270 * units.deg - 80 * units.deg, exhaust_closes: 540 * units.deg + 70 * units.deg, exhaust_flow: 450.0)
    )
    mazda_rotor r2(
        phase: 180 * units.deg, intake: intake, exhaust_system: exhaust0,
        wire0: wires.w3, wire1: wires.w4, wire2: wires.w5,
        primary_length: 6.5 * units.inch,
        ports: mazda_rotor_ports(phase: 180 * units.deg,
            intake_opens: 540 * units.deg - 80 * units.deg, intake_closes: 810 * units.deg + 80 * units.deg, intake_flow: 480.0,
            exhaust_opens: 270 * units.deg - 80 * units.deg, exhaust_closes: 540 * units.deg + 70 * units.deg, exhaust_flow: 450.0)
    )
    mazda_rotor r3(
        phase: 90 * units.deg, intake: intake, exhaust_system: exhaust0,
        wire0: wires.w6, wire1: wires.w7, wire2: wires.w8,
        primary_length: 7 * units.inch,
        ports: mazda_rotor_ports(phase: 90 * units.deg,
            intake_opens: 540 * units.deg - 80 * units.deg, intake_closes: 810 * units.deg + 80 * units.deg, intake_flow: 480.0,
            exhaust_opens: 270 * units.deg - 80 * units.deg, exhaust_closes: 540 * units.deg + 70 * units.deg, exhaust_flow: 450.0)
    )
    mazda_rotor r4(
        phase: 270 * units.deg, intake: intake, exhaust_system: exhaust0,
        wire0: wires.w9, wire1: wires.w10, wire2: wires.w11,
        primary_length: 7.5 * units.inch,
        ports: mazda_rotor_ports(phase: 270 * units.deg,
            intake_opens: 540 * units.deg - 80 * units.deg, intake_closes: 810 * units.deg + 80 * units.deg, intake_flow: 480.0,
            exhaust_opens: 270 * units.deg - 80 * units.deg, exhaust_closes: 540 * units.deg + 70 * units.deg, exhaust_flow: 450.0)
    )

    engine
        .add_cylinder_bank(r1)
        .add_cylinder_bank(r2)
        .add_cylinder_bank(r3)
        .add_cylinder_bank(r4)
    engine.add_crankshaft(c0)

    ignition_module ignition_module(
        timing_curve: rotary_timing(),
        rev_limit: 9300 * units.rpm,
        limiter_duration: 0.08
    )
    ignition_module
        .connect_wire(wires.w0, 0 * units.deg) // rotor 1 face 0
        .connect_wire(wires.w6, 90 * units.deg) // rotor 3 face 0
        .connect_wire(wires.w3, 180 * units.deg) // rotor 2 face 0
        .connect_wire(wires.w9, 270 * units.deg) // rotor 4 face 0
        .connect_wire(wires.w1, 360 * units.deg) // rotor 1 face 1
        .connect_wire(wires.w7, 450 * units.deg) // rotor 3 face 1
        .connect_wire(wires.w4, 540 * units.deg) // rotor 2 face 1
        .connect_wire(wires.w10, 630 * units.deg) // rotor 4 face 1
        .connect_wire(wires.w2, 720 * units.deg) // rotor 1 face 2
        .connect_wire(wires.w8, 810 * units.deg) // rotor 3 face 2
        .connect_wire(wires.w5, 900 * units.deg) // rotor 2 face 2
        .connect_wire(wires.w11, 990 * units.deg) // rotor 4 face 2

    engine.add_ignition_module(ignition_module)
}

private node rotary_vehicle {
    alias output __out:
        vehicle(
            mass: 850 * units.kg,
            drag_coefficient: 0.29,
            cross_sectional_area: (68 * units.inch) * (48 * units.inch),
            diff_ratio: 4.1,
            tire_radius: 12 * units.inch,
            rolling_resistance: 200 * units.N
        );
}

private node rotary_transmission {
    alias output __out:
        transmission(max_clutch_torque: 400 * units.lb_ft)
        .add_gear(3.48)
        .add_gear(2.02)
        .add_gear(1.39)
        .add_gear(1.00)
        .add_gear(0.72);
}

public node main {
    set_engine(mazda_26b())
    set_vehicle(rotary_vehicle())
    set_transmission(rotary_transmission())
}

use_default_theme()
main()
