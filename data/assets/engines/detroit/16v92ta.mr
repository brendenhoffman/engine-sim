// Detroit Diesel 16V-92TA [two-stroke V16 turbo diesel], 24.1 L (1472 cu in): two 8V-92s end to
// end, two turbos ahead of two blowers and aftercoolers. About 1080 hp at 2300 rpm (mining trucks,
// boats, generators).
// Generated by tools/detroit_gen.py from tools/detroit_specs.json: bore 4.84 in, stroke 5.0 in, 16 cylinders in a 63.5 deg V.

import "engine_sim.mr"
import "themes/default.mr"
import "detroit_two_stroke.mr"

units units()
constants constants()
impulse_response_library ir_lib()

private node wires {
    output wire1: ignition_wire();
    output wire2: ignition_wire();
    output wire3: ignition_wire();
    output wire4: ignition_wire();
    output wire5: ignition_wire();
    output wire6: ignition_wire();
    output wire7: ignition_wire();
    output wire8: ignition_wire();
    output wire9: ignition_wire();
    output wire10: ignition_wire();
    output wire11: ignition_wire();
    output wire12: ignition_wire();
    output wire13: ignition_wire();
    output wire14: ignition_wire();
    output wire15: ignition_wire();
    output wire16: ignition_wire();
}

public node detroit_16v92ta {
    alias output __out: engine;

    engine engine(
        name: "Detroit Diesel 16V-92TA [two-stroke V16 turbo diesel]",
        starter_torque: 1200 * units.lb_ft,
        starter_speed: 150 * units.rpm,
        redline: 2500 * units.rpm,
        cycle_angle: 360 * units.deg,       // Two-stroke: every cylinder fires every turn
        real_gas: 1,
        pipe_resolution: 12,               // Waves in the exhaust pipes: the bark and rasp
        friction_model: 1,
        fmep_constant: 60 * units.kPa,      // Plain bearings, gear train, blower
        idle_rpm: 600 * units.rpm,
        // The governor: mechanical, limiting speed
        diesel_idle_speed: 600 * units.rpm,
        diesel_rated_speed: 2300 * units.rpm,
        diesel_fuel_per_injection: 0.106 * units.g,
        diesel_peak_torque_speed: 1500 * units.rpm,
        diesel_rated_fuel: 0.85,
        diesel_max_fuel: 0.8,                // Smoke limit
        diesel_idle_max_fuel: 0.35,
        jake_brake_flow: k_carb(60),
        combustion_noise: 0,

        // Uniflow scavenging: air in through ports low in the liner, from the airbox the blower
        // fills; out through the exhaust valves in the head
        transfer_port_duration: 120 * units.deg,
        transfer_port_flow: k_carb(600),
        crankcase_ratio: 0,                 // No crankcase pumping: the blower does it
        exhaust_port_duration: 0,           // Exhaust valves, not ports
        scavenging_quality: 2,             // Uniflow: the air pushes the exhaust out ahead of it

        fuel: diesel_fuel(
            max_burning_efficiency: 0.95,
            injector_spread: 0.01,
            idle_shot_variation: 0.25
        ),
        hf_gain: 0.002,
        noise: 0.3,
        jitter: 0.25,
        simulation_frequency: 8000
    )

    wires wires()

    label stroke(5 * units.inch)
    label bore(4.84 * units.inch)
    label rod_length(10.125 * units.inch)
    label rod_mass(4.6 * units.kg)
    label compression_height(3.0 * units.inch)
    label crank_mass(192 * units.kg)
    label flywheel_mass(150 * units.kg)
    label flywheel_radius(9 * units.inch)

    crankshaft c0(
        throw: stroke / 2,
        flywheel_mass: flywheel_mass,
        mass: crank_mass,
        friction_torque: 10.0 * units.lb_ft,
        moment_of_inertia:
            disk_moment_of_inertia(mass: crank_mass, radius: stroke / 2)
            + disk_moment_of_inertia(mass: flywheel_mass, radius: flywheel_radius)
            + disk_moment_of_inertia(mass: 80 * units.kg, radius: 8.0 * units.cm),   // Blower, gear train, balancers
        position_x: 0.0,
        position_y: 0.0,
        tdc: constants.pi / 2
    )

    // Each pin carries a left- and a right-bank rod side by side
    rod_journal rj0(angle: 0 * units.deg)
    rod_journal rj1(angle: 270 * units.deg)
    rod_journal rj2(angle: 90 * units.deg)
    rod_journal rj3(angle: 180 * units.deg)
    rod_journal rj4(angle: 45 * units.deg)
    rod_journal rj5(angle: 315 * units.deg)
    rod_journal rj6(angle: 135 * units.deg)
    rod_journal rj7(angle: 225 * units.deg)
    c0
        .add_rod_journal(rj0)
        .add_rod_journal(rj1)
        .add_rod_journal(rj2)
        .add_rod_journal(rj3)
        .add_rod_journal(rj4)
        .add_rod_journal(rj5)
        .add_rod_journal(rj6)
        .add_rod_journal(rj7)

    piston_parameters piston_params(
        mass: 4.2 * units.kg,
        blowby: 0,
        compression_height: compression_height,
        wrist_pin_position: 0.0,
        displacement: 0.0
    )
    connecting_rod_parameters cr_params(
        mass: rod_mass,
        moment_of_inertia: rod_moment_of_inertia(mass: rod_mass, length: rod_length),
        center_of_mass: 0.0,
        length: rod_length
    )
    cylinder_bank_parameters bank_params(
        bore: bore,
        deck_height: stroke / 2 + rod_length + compression_height
    )

    // The airbox around the liners: no throttle, the governor sets the fuel
    intake intake(
        plenum_volume: 40 * units.L,
        plenum_cross_section_area: 400 * units.cm2,
        intake_flow_rate: k_carb(9600),
        runner_flow_rate: k_carb(800),
        runner_length: 10 * units.inch,
        idle_flow_rate: k_carb(0.0),
        idle_throttle_plate_position: 0.0
    )

    exhaust_system_parameters es_params(
        outlet_flow_rate: k_carb(4800),
        primary_tube_length: 10 * units.inch,
        primary_flow_rate: k_carb(800),
        velocity_decay: 1.0
    )
    exhaust_system exhaust0(
        es_params,
        length: 100 * units.inch,
        audio_volume: 0.2,
        manifold_relative_sound: 0.5,
        manifold_relative_sound_idle: 0,
        impulse_response: ir_lib.straight_stack_0)

    // Two turbos into two blowers, then the aftercoolers
    forced_induction blower(
        intake: intake,
        exhaust_system: exhaust0,
        charge_volume: 9.6 * units.L,
        interstage_volume: 24 * units.L,
        intercooler: 0.5,
        whine_floor: 0.3,
        hiss_volume: 0.3,
        whine_volume: 1
    )
    // No wastegate: the turbo is sized to the engine
    blower.add_stage(
        turbocharger(
            compressor_radius: 40 * units.mm,
            compressor_flow: 1.3 * units.kg / units.sec,
            turbine_radius: 40 * units.mm,
            turbine_flow: k_carb(600),
            inertia: 0.0004,
            max_speed: 95000 * units.rpm,
            duct_area: 50 * units.cm2,
            whine_order: 13,
            feeds_blower: 1.0                   // Into the blower's inlet
        )
    )
    blower.add_stage(
        turbocharger(
            compressor_radius: 40 * units.mm,
            compressor_flow: 1.3 * units.kg / units.sec,
            turbine_radius: 40 * units.mm,
            turbine_flow: k_carb(600),
            inertia: 0.0004,
            max_speed: 95000 * units.rpm,
            duct_area: 50 * units.cm2,
            whine_order: 13,
            feeds_blower: 1.0                   // Into the blower's inlet
        )
    )
    blower.add_stage(
        roots_supercharger(
            displacement: 1172 * units.cubic_inches,
            leakage: 9.6 * units.cm2,
            efficiency: 0.6,
            drive_ratio: 2,
            max_speed: 6000 * units.rpm,
            friction: 0.0013,
            lobes: 6.0,                        // Two three-lobe rotors
            gear_order: 0,
            gear_volume: 0.3
        )
    )

    cylinder_bank b0(bank_params, angle: 31.75 * units.deg)   // Left bank
    cylinder_bank b1(bank_params, angle: -31.75 * units.deg)   // Right bank

    b0
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.1)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj0,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire1,
            primary_length: 11 * units.inch,
            sound_attenuation: 1
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.05)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj1,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire2,
            primary_length: 9 * units.inch,
            sound_attenuation: 1
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.05)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj2,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire3,
            primary_length: 7 * units.inch,
            sound_attenuation: 1
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.1)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj3,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire4,
            primary_length: 5 * units.inch,
            sound_attenuation: 1
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.05)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj4,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire5,
            primary_length: 5 * units.inch,
            sound_attenuation: 1
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.05)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj5,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire6,
            primary_length: 7 * units.inch,
            sound_attenuation: 1
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.1)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj6,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire7,
            primary_length: 9 * units.inch,
            sound_attenuation: 1
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.05)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj7,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire8,
            primary_length: 11 * units.inch,
            sound_attenuation: 1
        )

    b1
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.05)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj0,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire9,
            primary_length: 11 * units.inch,
            sound_attenuation: 1
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.1)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj1,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire10,
            primary_length: 9 * units.inch,
            sound_attenuation: 1
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.05)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj2,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire11,
            primary_length: 7 * units.inch,
            sound_attenuation: 1
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.05)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj3,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire12,
            primary_length: 5 * units.inch,
            sound_attenuation: 1
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.1)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj4,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire13,
            primary_length: 5 * units.inch,
            sound_attenuation: 1
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.05)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj5,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire14,
            primary_length: 7 * units.inch,
            sound_attenuation: 1
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.05)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj6,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire15,
            primary_length: 9 * units.inch,
            sound_attenuation: 1
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.1)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj7,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire16,
            primary_length: 11 * units.inch,
            sound_attenuation: 1
        )

    engine.add_cylinder_bank(b0)
    engine.add_cylinder_bank(b1)
    engine.add_crankshaft(c0)

    // The exhaust valves peak 165 deg after each cylinder's TDC
    detroit_exhaust_lobe exhaust_lobe(duration: 105 * units.deg)
    camshaft_parameters cam_params(advance: 0.0, base_radius: 0.75 * units.inch)
    camshaft exhaust_cam0(cam_params, lobe_profile: exhaust_lobe)
    exhaust_cam0
        .add_lobe(493.25 * units.deg)
        .add_lobe(403.25 * units.deg)
        .add_lobe(223.25 * units.deg)
        .add_lobe(313.25 * units.deg)
        .add_lobe(178.25 * units.deg)
        .add_lobe(448.25 * units.deg)
        .add_lobe(268.25 * units.deg)
        .add_lobe(358.25 * units.deg)
    camshaft exhaust_cam1(cam_params, lobe_profile: exhaust_lobe)
    exhaust_cam1
        .add_lobe(196.75 * units.deg)
        .add_lobe(466.75 * units.deg)
        .add_lobe(286.75 * units.deg)
        .add_lobe(376.75 * units.deg)
        .add_lobe(241.75 * units.deg)
        .add_lobe(511.75 * units.deg)
        .add_lobe(331.75 * units.deg)
        .add_lobe(421.75 * units.deg)

    b0.set_cylinder_head(
        detroit_head(
            exhaust_camshaft: exhaust_cam0,
            chamber_volume: 94.2175 * units.cc,   // 17:1
            flow_attenuation: 1.6
        )
    )
    b1.set_cylinder_head(
        detroit_head(
            exhaust_camshaft: exhaust_cam1,
            chamber_volume: 94.2175 * units.cc,   // 17:1
            flow_attenuation: 1.6,
            flip_display: true
        )
    )

    // Start of injection, degrees before TDC (the unit injectors' cam timing)
    function timing_curve(1000 * units.rpm)
    timing_curve
        .add_sample(0 * units.rpm, 10 * units.deg)
        .add_sample(1000 * units.rpm, 12 * units.deg)
        .add_sample(2000 * units.rpm, 15 * units.deg)
        .add_sample(3000 * units.rpm, 16 * units.deg)

    engine.add_ignition_module(
        ignition_module(timing_curve: timing_curve, rev_limit: 2900 * units.rpm, limiter_duration: 0.1)
            .connect_wire(wires.wire5, 13.25 * units.deg)
            .connect_wire(wires.wire9, 31.75 * units.deg)
            .connect_wire(wires.wire3, 58.25 * units.deg)
            .connect_wire(wires.wire13, 76.75 * units.deg)
            .connect_wire(wires.wire7, 103.25 * units.deg)
            .connect_wire(wires.wire11, 121.75 * units.deg)
            .connect_wire(wires.wire4, 148.25 * units.deg)
            .connect_wire(wires.wire15, 166.75 * units.deg)
            .connect_wire(wires.wire8, 193.25 * units.deg)
            .connect_wire(wires.wire12, 211.75 * units.deg)
            .connect_wire(wires.wire2, 238.25 * units.deg)
            .connect_wire(wires.wire16, 256.75 * units.deg)
            .connect_wire(wires.wire6, 283.25 * units.deg)
            .connect_wire(wires.wire10, 301.75 * units.deg)
            .connect_wire(wires.wire1, 328.25 * units.deg)
            .connect_wire(wires.wire14, 346.75 * units.deg)
    )
}

public node main {
    set_engine(detroit_16v92ta())
    set_transmission(detroit_transmission())
    set_vehicle(detroit_truck())
}

use_default_theme()
main()
