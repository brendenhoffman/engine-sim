    'engines/basic/src/window_handler.cpp',
  ),
  include_directories: delta_inc,
  dependencies: [sdl_dep, gl_dep],
)

# Devices register themselves from static constructors, so every object must be linked in
delta_dep = declare_dependency(
  link_whole: delta_lib,
  include_directories: [third_party_inc, delta_inc],
  dependencies: [sdl_dep, gl_dep],
)
